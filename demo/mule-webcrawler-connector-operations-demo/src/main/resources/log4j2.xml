<?xml version="1.0" encoding="utf-8"?>
<Configuration>

<Appenders>
    <RollingFile name="chromedriverFile" fileName="${sys:mule.home}/logs/chromedriver.log"
                 filePattern="${sys:mule.home}/logs/chromedriver-%i.log">
        <PatternLayout pattern="%-5p %d [%t] %c: %m%n"/>
        <SizeBasedTriggeringPolicy size="10 MB"/>
        <DefaultRolloverStrategy max="5"/>
    </RollingFile>

    <!-- Existing main appender -->
    <RollingFile name="file" fileName="${sys:mule.home}/logs/ms-webcrawler-app-0.1.25.log"
                 filePattern="${sys:mule.home}/logs/ms-webcrawler-app-0.1.25-%i.log">
        <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
        <SizeBasedTriggeringPolicy size="10 MB"/>
        <DefaultRolloverStrategy max="10"/>
    </RollingFile>
</Appenders>

<Loggers>
    <AsyncLogger name="org.mule.extension.webcrawler.internal" level="DEBUG"/>
    
    <!-- Logger for chromedriver -->
    <AsyncLogger name="org.openqa.selenium" level="INFO">
        <AppenderRef ref="chromedriverFile"/>
    </AsyncLogger>

    <AsyncRoot level="INFO">
        <AppenderRef ref="file"/>
    </AsyncRoot>
</Loggers>

</Configuration>
