<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:file="http://www.mulesoft.org/schema/mule/file"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:webcrawler="http://www.mulesoft.org/schema/mule/webcrawler"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/webcrawler http://www.mulesoft.org/schema/mule/webcrawler/current/mule-webcrawler.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

    <configuration-properties file="config.properties"/>

    <http:listener-config name="HTTP_Listener_config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <!-- HTTP-fetch config used by all per-page operations and get-sitemap. The seed URL is empty
         here (page-* operations take a URL per-call and never call the queue path) — but queueName
         is still required so the runtime can register the queue at startup. -->
    <webcrawler:config name="HTTP_Configuration" queueName="demo-http-queue">
        <webcrawler:http-connection userAgent="${webcrawler.userAgent}" referrer="${webcrawler.referrer}"/>
    </webcrawler:config>

    <!-- Remote WebDriver fetch config. Required for shadow-DOM / wait-for-xpath / dynamic-content
         crawl behavior. Without `webcrawler.remoteBrowser.url` set in config.properties or as a
         system property, this config will fail at startup — comment it out (and the corresponding
         <when> branches below) if you don't have a remote browser endpoint to point at. -->
    <webcrawler:config name="WebDriver_Configuration" queueName="demo-webdriver-queue">
        <webcrawler:remote-webdriver-connection
                remoteUrl="${webcrawler.remoteBrowser.url}"
                userAgent="${webcrawler.userAgent}"
                referrer="${webcrawler.referrer}"/>
    </webcrawler:config>

    <!-- Crawl-website-source config: the new streaming Source seeds from `url` and emits one event
         per fetched page. Configure your seed URL in config.properties (`webcrawler.crawl.seedUrl`)
         before deploying. -->
    <webcrawler:config name="Crawl_Source_Configuration"
                       url="${webcrawler.crawl.seedUrl}"
                       queueName="demo-crawl-source-queue">
        <webcrawler:http-connection userAgent="${webcrawler.userAgent}" referrer="${webcrawler.referrer}"/>
    </webcrawler:config>

    <os:object-store name="crawlVisitedStore" persistent="false"/>

    <apikit:config name="webcrawler-connector-operations-api-config"
                   api="api/webcrawler-connector-operations-api.raml"
                   outboundHeadersMapName="outboundHeaders"
                   httpStatusVarName="httpStatus"/>

    <flow name="mule-webcrawler-connector-operations-demoFlow">
        <http:listener config-ref="HTTP_Listener_config" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="webcrawler-connector-operations-api-config"/>
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="WEBCRAWLER:CRAWL_ON_PAGE_DISALLOWED_ERROR">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ "message": error.description }]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">403</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ "message": error.description }]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <flow name="mule-webcrawler-connector-operations-demoFlow1">
        <http:listener config-ref="HTTP_Listener_config" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="webcrawler-connector-operations-api-config"/>
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <flow name="post:\page:webcrawler-connector-operations-api-config">
        <choice>
            <when expression='#[attributes.queryParams.connection == "webdriver"]'>
                <logger level="INFO" message='#[output text&#10;---&#10;"\n\n🕷️  Dynamic Page Crawling — URL: " ++ (attributes.queryParams.url default "") ++ "\n"]'/>
                <webcrawler:page-content config-ref="WebDriver_Configuration"
                                         url="#[attributes.queryParams.url]"
                                         outputFormat="#[attributes.queryParams.outputFormat]"
                                         waitOnPageLoad="#[attributes.queryParams.waitOnPageLoad]"
                                         waitForXPath="#[attributes.queryParams.waitForXPath]"
                                         extractShadowDom="#[attributes.queryParams.extractShadowDom]"
                                         shadowHostXPath="#[attributes.queryParams.shadowDomHostXPath]">
                    <webcrawler:javascript><![CDATA[#[(payload default {}).javascript default ""]]]></webcrawler:javascript>
                    <webcrawler:tags/>
                </webcrawler:page-content>
            </when>
            <otherwise>
                <webcrawler:page-content config-ref="HTTP_Configuration"
                                         url="#[attributes.queryParams.url]"
                                         outputFormat="#[attributes.queryParams.outputFormat]"/>
            </otherwise>
        </choice>
    </flow>

    <flow name="get:\insights:webcrawler-connector-operations-api-config">
        <choice>
            <when expression='#[attributes.queryParams.connection == "webdriver"]'>
                <webcrawler:page-insights config-ref="WebDriver_Configuration"
                                          url="#[attributes.queryParams.url]"
                                          waitOnPageLoad="#[attributes.queryParams.waitOnPageLoad]"/>
            </when>
            <otherwise>
                <webcrawler:page-insights config-ref="HTTP_Configuration"
                                          url="#[attributes.queryParams.url]"/>
            </otherwise>
        </choice>
    </flow>

    <flow name="get:\sitemap:webcrawler-connector-operations-api-config">
        <choice>
            <when expression='#[attributes.queryParams.connection == "webdriver"]'>
                <webcrawler:get-sitemap config-ref="WebDriver_Configuration"
                                        url="#[attributes.queryParams.url]"
                                        maxDepth="#[attributes.queryParams.depth]"
                                        regexUrlsFilterLogic="EXCLUDE"
                                        waitOnPageLoad="#[attributes.queryParams.waitOnPageLoad]"
                                        restrictToPath="true">
                    <webcrawler:regex-urls>
                        <webcrawler:regex-url value="https://www\.googletagmanager\.com/.*"/>
                        <webcrawler:regex-url value="javascript:void(0);"/>
                    </webcrawler:regex-urls>
                </webcrawler:get-sitemap>
            </when>
            <otherwise>
                <webcrawler:get-sitemap config-ref="HTTP_Configuration"
                                        url="#[attributes.queryParams.url]"
                                        maxDepth="#[attributes.queryParams.depth]"
                                        restrictToPath="true">
                    <webcrawler:regex-urls/>
                </webcrawler:get-sitemap>
            </otherwise>
        </choice>
        <logger level="INFO" message='#[%dw 2.0&#10;output text/plain&#10;---&#10;"\n" ++ write(attributes, "application/json")]'/>
    </flow>

    <flow name="get:\metatag:webcrawler-connector-operations-api-config">
        <choice>
            <when expression='#[attributes.queryParams.connection == "webdriver"]'>
                <webcrawler:page-meta-tags config-ref="WebDriver_Configuration"
                                           url="#[attributes.queryParams.url]"
                                           waitOnPageLoad="#[attributes.queryParams.waitOnPageLoad]"/>
            </when>
            <otherwise>
                <webcrawler:page-meta-tags config-ref="HTTP_Configuration"
                                           url="#[attributes.queryParams.url]"/>
            </otherwise>
        </choice>
    </flow>

    <flow name="get:\image:webcrawler-connector-operations-api-config">
        <choice>
            <when expression='#[attributes.queryParams.connection == "webdriver"]'>
                <webcrawler:page-download-image config-ref="WebDriver_Configuration"
                                                url="#[attributes.queryParams.url]"
                                                maxImageNumber="50"
                                                downloadPath="#[attributes.queryParams.downloadLocation]"
                                                waitOnPageLoad="#[attributes.queryParams.waitOnPageLoad]"/>
            </when>
            <otherwise>
                <webcrawler:page-download-image config-ref="HTTP_Configuration"
                                                url="#[attributes.queryParams.url]"
                                                downloadPath="#[attributes.queryParams.downloadLocation]"
                                                maxImageNumber="50"/>
            </otherwise>
        </choice>
    </flow>

    <flow name="get:\document:webcrawler-connector-operations-api-config">
        <choice>
            <when expression='#[attributes.queryParams.connection == "webdriver"]'>
                <webcrawler:page-download-document config-ref="WebDriver_Configuration"
                                                   url="#[attributes.queryParams.url]"
                                                   maxDocumentNumber="50"
                                                   downloadPath="#[attributes.queryParams.downloadLocation]"
                                                   waitOnPageLoad="#[attributes.queryParams.waitOnPageLoad]"/>
            </when>
            <otherwise>
                <webcrawler:page-download-document config-ref="HTTP_Configuration"
                                                   url="#[attributes.queryParams.url]"
                                                   downloadPath="#[attributes.queryParams.downloadLocation]"
                                                   maxDocumentNumber="50"/>
            </otherwise>
        </choice>
    </flow>

    <flow name="get:\search:webcrawler-connector-operations-api-config">
        <webcrawler:search-google query="#[attributes.queryParams.query]"
                                  apiKey="#[attributes.headers.'Serper-Api-Key']"/>
    </flow>

    <!-- Crawl-website-source demo flow. Replaces the old crawl-website-full-scan and
         crawl-website-streaming operations. The Source seeds from the config's `url` parameter
         at startup and emits one event per fetched page (depth from `maxDepth`). Each event lands
         here; this flow just logs it, but in real apps you'd pipe it to S3 / Data Cloud / Kafka /
         a markdown sink. -->
    <flow name="crawlerSourceFlow">
        <webcrawler:crawl-website-source config-ref="Crawl_Source_Configuration"
                                         outputFormat="HTML"
                                         maxDepth="${webcrawler.crawl.maxDepth}"
                                         restrictToPath="true"
                                         objectStore="crawlVisitedStore"/>
        <logger level="INFO"
                message='#["CRAWLED  depth=" ++ (attributes.depth as String)
                       ++ "  status=" ++ (attributes.statusCode as String)
                       ++ "  mime=" ++ (attributes.contentType default "-")
                       ++ "  url=" ++ attributes.url]'/>
    </flow>

</mule>
