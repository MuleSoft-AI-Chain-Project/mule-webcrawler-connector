<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ms-webcrawler="http://www.mulesoft.org/schema/mule/ms-webcrawler"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ms-webcrawler http://www.mulesoft.org/schema/mule/ms-webcrawler/current/mule-ms-webcrawler.xsd">

    <!-- Test Suite for Page Operations -->
    <munit:config name="page-operations-test-suite.xml" />

    <!-- Test: Get Meta Tags - Success Case -->
    <munit:test name="test-page-meta-tags-success" description="Test successful retrieval of meta tags from a web page">
        <munit:behavior>
            <set-variable variableName="testUrl" value="https://mac-project.ai/" doc:name="Set Test URL" />
        </munit:behavior>
        
        <munit:execution>
            <ms-webcrawler:page-meta-tags 
                doc:name="Get meta tags" 
                config-ref="Test_HTTP_Configuration" 
                url="#[vars.testUrl]" />
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
            
            <!-- Verify attributes contain URL -->
            <munit-tools:assert-that 
                doc:name="Assert attributes contain URL" 
                expression="#[attributes.url]" 
                is="#[MunitTools::equalTo(vars.testUrl)]" />
            
            <!-- Verify attributes contain title -->
            <munit-tools:assert-that 
                doc:name="Assert attributes contain title" 
                expression="#[attributes.title]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Meta Tags - Invalid URL -->
    <munit:test name="test-page-meta-tags-invalid-url" description="Test error handling for invalid URL" expectedErrorType="MS-WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE">
        <munit:execution>
            <ms-webcrawler:page-meta-tags 
                doc:name="Get meta tags with invalid URL" 
                config-ref="Test_HTTP_Configuration" 
                url="invalid-url" />
        </munit:execution>
    </munit:test>

    <!-- Test: Get Meta Tags - With Robots.txt Config -->
    <munit:test name="test-page-meta-tags-robots-config" description="Test that robots.txt configuration is applied">
        <munit:execution>
            <!-- Use a URL with robots.txt config enabled -->
            <ms-webcrawler:page-meta-tags 
                doc:name="Get meta tags with robots config" 
                config-ref="Test_HTTP_Configuration_With_Robots" 
                url="https://mac-project.ai/" />
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Meta Tags - Verify Payload -->
    <munit:test name="test-page-meta-tags-payload" description="Test that meta tags payload is valid">
        <munit:execution>
            <ms-webcrawler:page-meta-tags 
                doc:name="Get meta tags" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/" />
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
            
            <!-- Verify payload size is greater than 0 -->
            <munit-tools:assert-that 
                doc:name="Assert payload has content" 
                expression="#[sizeOf(payload)]" 
                is="#[MunitTools::greaterThan(0)]" />
        </munit:validation>
    </munit:test>

</mule>
