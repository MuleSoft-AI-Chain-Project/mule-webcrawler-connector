<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ms-webcrawler="http://www.mulesoft.org/schema/mule/ms-webcrawler"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ms-webcrawler http://www.mulesoft.org/schema/mule/ms-webcrawler/current/mule-ms-webcrawler.xsd">

    <!-- Test Suite for Page Content Operation -->
    <munit:config name="page-content-test-suite.xml" />

    <!-- Test: Get Page Content - HTML Format -->
    <munit:test name="test-page-content-html" description="Test successful retrieval of page content in HTML format">
        <munit:behavior>
            <set-variable variableName="testUrl" value="https://mac-project.ai/" doc:name="Set Test URL" />
        </munit:behavior>
        
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get page content as HTML" 
                config-ref="Test_HTTP_Configuration" 
                url="#[vars.testUrl]"
                outputFormat="HTML">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
            
            <!-- Verify attributes contain URL -->
            <munit-tools:assert-that 
                doc:name="Assert attributes contain URL" 
                expression="#[attributes.url]" 
                is="#[MunitTools::equalTo(vars.testUrl)]" />
            
            <!-- Verify attributes contain title -->
            <munit-tools:assert-that 
                doc:name="Assert attributes contain title" 
                expression="#[attributes.title]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Page Content - TEXT Format -->
    <munit:test name="test-page-content-text" description="Test retrieval of page content in TEXT format">
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get page content as TEXT" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/"
                outputFormat="TEXT">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
            
            <!-- Verify attributes contain URL -->
            <munit-tools:assert-that 
                doc:name="Assert attributes contain URL" 
                expression="#[attributes.url]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Page Content - MARKDOWN Format -->
    <munit:test name="test-page-content-markdown" description="Test retrieval of page content in MARKDOWN format">
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get page content as MARKDOWN" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/"
                outputFormat="MARKDOWN">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Page Content - Invalid URL -->
    <munit:test name="test-page-content-invalid-url" description="Test error handling for invalid URL" expectedErrorType="MS-WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE">
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get content with invalid URL" 
                config-ref="Test_HTTP_Configuration" 
                url="invalid-url"
                outputFormat="HTML">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
        </munit:execution>
    </munit:test>

    <!-- Test: Get Page Content - With Specific Tags -->
    <munit:test name="test-page-content-with-tags" description="Test page content with specific HTML tags">
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get content for specific tags" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/"
                outputFormat="HTML">
                <ms-webcrawler:tags>
                    <ms-webcrawler:tag value="h1" />
                    <ms-webcrawler:tag value="p" />
                    <ms-webcrawler:tag value="a" />
                </ms-webcrawler:tags>
            </ms-webcrawler:page-content>
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Page Content - Verify Payload -->
    <munit:test name="test-page-content-payload" description="Test that page content payload is valid">
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get page content" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/"
                outputFormat="TEXT">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
        </munit:execution>
        
        <munit:validation>
            <!-- Verify payload is not null -->
            <munit-tools:assert-that 
                doc:name="Assert payload is not null" 
                expression="#[payload]" 
                is="#[MunitTools::notNullValue()]" />
            
            <!-- Verify payload size is greater than 0 -->
            <munit-tools:assert-that 
                doc:name="Assert payload has content" 
                expression="#[sizeOf(payload)]" 
                is="#[MunitTools::greaterThan(0)]" />
        </munit:validation>
    </munit:test>

    <!-- Test: Get Page Content - All Output Formats -->
    <munit:test name="test-page-content-all-formats" description="Test that all output formats work">
        <munit:execution>
            <ms-webcrawler:page-content 
                doc:name="Get page content HTML" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/"
                outputFormat="HTML">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
            
            <set-variable variableName="htmlPayload" value="#[payload]" doc:name="Store HTML payload" />
            
            <ms-webcrawler:page-content 
                doc:name="Get page content TEXT" 
                config-ref="Test_HTTP_Configuration" 
                url="https://mac-project.ai/"
                outputFormat="TEXT">
                <ms-webcrawler:tags />
            </ms-webcrawler:page-content>
            
            <set-variable variableName="textPayload" value="#[payload]" doc:name="Store TEXT payload" />
        </munit:execution>
        
        <munit:validation>
            <!-- Verify both payloads are not null -->
            <munit-tools:assert-that 
                doc:name="Assert HTML payload is not null" 
                expression="#[vars.htmlPayload]" 
                is="#[MunitTools::notNullValue()]" />
            
            <munit-tools:assert-that 
                doc:name="Assert TEXT payload is not null" 
                expression="#[vars.textPayload]" 
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>
    </munit:test>

</mule>
