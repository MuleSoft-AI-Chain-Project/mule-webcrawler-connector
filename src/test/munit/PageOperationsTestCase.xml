        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]" is="#[MunitTools::equalTo('MS-WEBCRAWLER:CRAWL_ON_PAGE_DISALLOWED_ERROR')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T16: page-insights against robots-disallowed URL -> CRAWL_ON_PAGE_DISALLOWED_ERROR.
         Exercises PageOperations.getPageInsights robots-enforced branch (L349-354). -->
    <munit:test name="PO-T16_page-insights_robots-disallowed" timeOut="20000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-insights config-ref="WebCrawler_HTTP_RobotsEnforced"
                                              url="${test.url.robots.denied}"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]" is="#[MunitTools::equalTo('MS-WEBCRAWLER:CRAWL_ON_PAGE_DISALLOWED_ERROR')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T17: page-download-image against a URL that returns a non-HTML (image) content-type.
         JSoup throws UnsupportedMimeTypeException -> single-image fallback branch (L182-185).
         Uses IANA's SVG logo, which Jsoup treats as a non-parseable MIME type. -->
    <munit:test name="PO-T17_page-download-image_unsupported-mime-fallback" timeOut="30000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-download-image config-ref="WebCrawler_HTTP"
                                                    url="https://www.iana.org/_img/2022/iana-logo-header.svg"
                                                    downloadPath="${java.io.tmpdir}"
                                                    maxImageNumber="1"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <!-- Either the single-image fallback downloaded the image (NONE) or raised
                 WEBCRAWLER_OPERATIONS_FAILURE during write. Pinning to those two specific
                 states (previously used containsString('WEBCRAWLER') which also matches
                 any unrelated MS-WEBCRAWLER:* error identifier). -->
            <munit-tools:assert-that expression="#[vars.errorType default 'MS-WEBCRAWLER:NONE']"
                                     is="#[MunitTools::anyOf([MunitTools::equalTo('MS-WEBCRAWLER:NONE'), MunitTools::equalTo('MS-WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE')])]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T18: page-download-document against a URL ending in `.pdf` -> isDocumentUrl branch
         (L266-268 direct download via PageHelper.downloadFile). We wrap in try/on-error-continue
         because an external PDF fetch may fail in CI; either a successful payload OR an
         inner-catch DOWNLOAD_DOCUMENTS_OPERATION_FAILURE still exercises the isDocumentUrl
         branch entry. -->
    <munit:test name="PO-T18_page-download-document_direct-pdf" timeOut="30000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-download-document config-ref="WebCrawler_HTTP"
                                                       url="https://www.africau.edu/images/default/sample.pdf"
                                                       downloadPath="${java.io.tmpdir}"
                                                       maxDocumentNumber="1"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <!-- Tightened: drop generic containsString('WEBCRAWLER') conjunct. The branch either
                 succeeds (NONE) via direct PageHelper.downloadFile, or the inner catch wraps
                 into DOWNLOAD_DOCUMENTS_OPERATION_FAILURE. These are the only two honest
                 outcomes for the isDocumentUrl branch. -->
            <munit-tools:assert-that expression="#[vars.errorType default 'MS-WEBCRAWLER:NONE']"
                                     is="#[MunitTools::anyOf([MunitTools::equalTo('MS-WEBCRAWLER:NONE'), MunitTools::equalTo('MS-WEBCRAWLER:DOWNLOAD_DOCUMENTS_OPERATION_FAILURE')])]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T19: page-download-document where the non-pdf crawl branch fails -> inner catch
         wraps into DOWNLOAD_DOCUMENTS_OPERATION_FAILURE (L278-284). Uses an unreachable local
         port so the outer robots check passes (robots.txt fetch fails-open quickly via
         ConnectException) and the inner getDocument throws, surfacing via the inner
         catch-to-ModuleException wrap. -->
    <munit:test name="PO-T19_page-download-document_inner-catch-wrap" timeOut="30000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-download-document config-ref="WebCrawler_HTTP"
                                                       url="http://127.0.0.1:1/"
                                                       downloadPath="${java.io.tmpdir}"
                                                       maxDocumentNumber="1"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]"
                                     is="#[MunitTools::equalTo('MS-WEBCRAWLER:DOWNLOAD_DOCUMENTS_OPERATION_FAILURE')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T20: page-content against an unreachable port (http://127.0.0.1:1/) -> generic
         Exception catch branch that wraps into WEBCRAWLER_OPERATIONS_FAILURE (L455-459). -->
    <munit:test name="PO-T20_page-content_unreachable-port" timeOut="30000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-content config-ref="WebCrawler_HTTP"
                                             url="http://127.0.0.1:1/"
                                             outputFormat="TEXT"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]"
                                     is="#[MunitTools::equalTo('MS-WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE')]"/>
        </munit:validation>
    </munit:test>

</mule>
