<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ms-webcrawler="http://www.mulesoft.org/schema/mule/ms-webcrawler"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ms-webcrawler http://www.mulesoft.org/schema/mule/ms-webcrawler/current/mule-ms-webcrawler.xsd">

    <munit:config name="PageOperationsTestCase.xml"/>

    <!-- PO-T01: page-meta-tags HTTP golden -->
    <munit:test name="PO-T01_page-meta-tags_http_happy" timeOut="20000">
        <munit:execution>
            <ms-webcrawler:page-meta-tags config-ref="WebCrawler_HTTP" url="${test.url.static}"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
            <munit-tools:assert-that expression="#[attributes.url]" is="#[MunitTools::equalTo('${test.url.static}')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T02: page-meta-tags RemoteWebDriver golden (remote-browser-tagged) -->
    <munit:test name="PO-T02_page-meta-tags_remote_happy" timeOut="60000" tags="remote-browser">
        <munit:execution>
            <ms-webcrawler:page-meta-tags config-ref="WebCrawler_Remote" url="${test.url.static}"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T03: page-meta-tags malformed URL -> WEBCRAWLER_OPERATIONS_FAILURE -->
    <munit:test name="PO-T03_page-meta-tags_malformed-url" timeOut="20000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-meta-tags config-ref="WebCrawler_HTTP" url="not-a-valid-url"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]" is="#[MunitTools::equalTo('MS-WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T04: page-content TEXT -->
    <munit:test name="PO-T04_page-content_http_text" timeOut="20000">
        <munit:execution>
            <ms-webcrawler:page-content config-ref="WebCrawler_HTTP"
                                         url="${test.url.static}"
                                         outputFormat="TEXT"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T05: page-content MARKDOWN (exercises html2markdown/**) -->
    <munit:test name="PO-T05_page-content_http_markdown" timeOut="20000">
        <munit:execution>
            <ms-webcrawler:page-content config-ref="WebCrawler_HTTP"
