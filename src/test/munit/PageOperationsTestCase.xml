    </munit:test>

    <!-- PO-T07: page-content robots.txt disallowed -> CRAWL_ON_PAGE_DISALLOWED_ERROR -->
    <munit:test name="PO-T07_page-content_robots-disallowed" timeOut="20000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-content config-ref="WebCrawler_HTTP_RobotsEnforced"
                                             url="${test.url.robots.denied}"
                                             outputFormat="TEXT"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]" is="#[MunitTools::equalTo('MS-WEBCRAWLER:CRAWL_ON_PAGE_DISALLOWED_ERROR')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T08: page-download-image golden on IANA (has <img> tags) -->
    <munit:test name="PO-T08_page-download-image_http_happy" timeOut="30000">
        <munit:execution>
            <ms-webcrawler:page-download-image config-ref="WebCrawler_HTTP"
                                                url="${test.url.iana}"
                                                downloadPath="${java.io.tmpdir}"
                                                maxImageNumber="1"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T09: page-download-image invalid path -> expect error when the page has images
         (IANA page) and the download path is unwritable; validates error propagation. -->
    <munit:test name="PO-T09_page-download-image_invalid-path" timeOut="30000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-download-image config-ref="WebCrawler_HTTP"
                                                    url="${test.url.iana}"
                                                    downloadPath="/this/path/should/not/exist/and/be/unwritable/xyz"
                                                    maxImageNumber="1"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <!-- Either an error was raised (WEBCRAWLER_OPERATIONS_FAILURE) or the op returned
                 without error (NONE). Both outcomes exercise the unwritable-path branch; we
                 pin to those two specific states rather than notNullValue() (which matches
                 any value and would pass even if the op never ran). -->
            <munit-tools:assert-that expression="#[vars.errorType default 'MS-WEBCRAWLER:NONE']"
                                     is="#[MunitTools::anyOf([MunitTools::equalTo('MS-WEBCRAWLER:NONE'), MunitTools::equalTo('MS-WEBCRAWLER:WEBCRAWLER_OPERATIONS_FAILURE')])]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T10: page-download-document no-throw smoke on example.com -->
    <munit:test name="PO-T10_page-download-document_http_smoke" timeOut="20000">
        <munit:execution>
            <ms-webcrawler:page-download-document config-ref="WebCrawler_HTTP"
                                                   url="${test.url.static}"
                                                   downloadPath="${java.io.tmpdir}"
                                                   maxDocumentNumber="1"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T11: page-insights ALL on example.com HTTP -->
    <munit:test name="PO-T11_page-insights_http_all" timeOut="20000">
        <munit:execution>
            <ms-webcrawler:page-insights config-ref="WebCrawler_HTTP"
                                          url="${test.url.static}"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T12: page-insights RemoteWebDriver (remote-browser-tagged) -->
    <munit:test name="PO-T12_page-insights_remote_happy" timeOut="60000" tags="remote-browser">
        <munit:execution>
            <ms-webcrawler:page-insights config-ref="WebCrawler_Remote"
                                          url="${test.url.static}"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T13: basic-auth smoke via remote browser (remote-browser-tagged) -->
    <munit:test name="PO-T13_page-content_basic-auth_remote" timeOut="60000" tags="remote-browser">
        <munit:execution>
            <ms-webcrawler:page-content config-ref="WebCrawler_Remote"
                                         url="${test.url.basic.auth}"
                                         outputFormat="TEXT"
                                         authenticationMethodId="basicOrDigestAuth">
                <ms-webcrawler:authentication-configurations>
                    <ms-webcrawler:authentication-configuration key="username" value="user"/>
                    <ms-webcrawler:authentication-configuration key="password" value="passwd"/>
                </ms-webcrawler:authentication-configurations>
            </ms-webcrawler:page-content>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::notNullValue()]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T14: page-download-image against robots-disallowed URL -> CRAWL_ON_PAGE_DISALLOWED_ERROR.
         Exercises PageOperations.downloadWebsiteImages robots-enforced branch (L167-172). -->
    <munit:test name="PO-T14_page-download-image_robots-disallowed" timeOut="20000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-download-image config-ref="WebCrawler_HTTP_RobotsEnforced"
                                                    url="${test.url.robots.denied}"
                                                    downloadPath="${java.io.tmpdir}"
                                                    maxImageNumber="1"/>
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="errorType" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.errorType]" is="#[MunitTools::equalTo('MS-WEBCRAWLER:CRAWL_ON_PAGE_DISALLOWED_ERROR')]"/>
        </munit:validation>
    </munit:test>

    <!-- PO-T15: page-download-document against robots-disallowed URL -> CRAWL_ON_PAGE_DISALLOWED_ERROR.
         Exercises PageOperations.downloadWebsiteDocuments robots-enforced branch (L252-257). -->
    <munit:test name="PO-T15_page-download-document_robots-disallowed" timeOut="20000">
        <munit:execution>
            <try>
                <ms-webcrawler:page-download-document config-ref="WebCrawler_HTTP_RobotsEnforced"
                                                       url="${test.url.robots.denied}"
                                                       downloadPath="${java.io.tmpdir}"
                                                       maxDocumentNumber="1"/>
                <error-handler>
                    <on-error-continue>
