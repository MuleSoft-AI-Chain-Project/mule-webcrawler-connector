<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:webcrawler="http://www.mulesoft.org/schema/mule/ms-webcrawler"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ms-webcrawler http://www.mulesoft.org/schema/mule/ms-webcrawler/current/mule-ms-webcrawler.xsd">

    <munit:config name="CrawlSourceHttpTestCase.xml"/>

    <import file="Config.xml"/>

    <os:object-store name="httpCrawlStore" persistent="false"/>

    <flow name="httpCrawlFlow" maxConcurrency="1">
        <webcrawler:crawl-website-source config-ref="httpStaticConfig"
                                         outputFormat="TEXT"
                                         maxDepth="0"
                                         restrictToPath="false"
                                         objectStore="httpCrawlStore"/>
        <munit-tools:queue queueName="httpCrawled">
            <munit-tools:value>
                #[output application/java --- {url: attributes.url, statusCode: attributes.statusCode, contentType: attributes.contentType, depth: attributes.depth}]
            </munit-tools:value>
        </munit-tools:queue>
    </flow>

    <!-- Source crawls the seed URL via plain HTTP and emits one event at depth 0. -->
    <munit:test name="source_crawls_seed_url_via_http" timeOut="60000">
        <munit:enable-flow-sources>
            <munit:enable-flow-source value="httpCrawlFlow"/>
        </munit:enable-flow-sources>
        <munit:validation>
            <until-successful maxRetries="60" millisBetweenRetries="1000">
                <munit-tools:dequeue queueName="httpCrawled"/>
            </until-successful>
            <munit-tools:assert-that expression="#[payload.url]"
                                     is="#[MunitTools::containsString('example.com')]"/>
            <munit-tools:assert-that expression="#[payload.statusCode]"
                                     is="#[MunitTools::equalTo(200)]"/>
            <munit-tools:assert-that expression="#[payload.contentType]"
                                     is="#[MunitTools::containsString('text/html')]"/>
            <munit-tools:assert-that expression="#[payload.depth]"
                                     is="#[MunitTools::equalTo(0)]"/>
        </munit:validation>
    </munit:test>

</mule>
